# This file is installed as ~/.config/kcoder/.env on first launch.
# Fill in your API key there. Existing files are never overwritten.
# Provider endpoints and model selections belong in settings.json.
# Uncomment the examples below only to explicitly override those settings.
KUNLUNMETA_BASE_API_KEY=
# KUNLUNMETA_BASE_URL=http://127.0.0.1:8000
# KUNLUNMETA_BASE_MODEL=MiniMax-M3
DEV_DEBUG=1

# KCoder public relay (TCP HTTPS/WSS; secrets only in .env)
KCODER_RELAY_SSH_HOST=aliyun
KCODER_RELAY_SSH_HOSTNAME=47.80.92.250
KCODER_RELAY_SSH_USER=admin
KCODER_RELAY_SSH_IDENTITY=~/.ssh/id_ed25519
KCODER_RELAY_DOMAIN=hyf2333.top
KCODER_RELAY_PUBLIC_PORT=8451
KCODER_RELAY_PUBLIC_URL=https://hyf2333.top:8451
KCODER_RELAY_ROUTE_MODE=path
KCODER_RELAY_PUBLIC_ORIGINS=https://hyf2333.top:8451
KCODER_RELAY_SHARED_HOSTS=hyf2333.top:8451
KCODER_RELAY_CONTROL_PORT=18452
KCODER_RELAY_PROXY_PORT=18451
# Automatic registration assigns an ID; set a Gateway ID only for static/legacy setups.
# KCODER_RELAY_GATEWAY_ID=cyx
KCODER_RELAY_LOCAL_GATEWAY=http://127.0.0.1:4186
# Single-Gateway migration compatibility; the new deployment reads the private JSON file below.
# KCODER_RELAY_DEVICE_ID=cyx
# KCODER_RELAY_SECRET=
KCODER_RELAY_GATEWAY_TOKEN=
KCODER_RELAY_KCODER_BIN=
KCODER_RELAY_SERVERS_FILE=

# Automatic registration: leave the key blank to disable enrollment. It only enrolls a new Gateway;
# it cannot access an existing one. Use a nonempty 32+ character URL-safe value to enable it.
# Keep the same private key in the deployment operator's .env and a new Gateway's private .env.
KCODER_RELAY_REGISTRATION_KEY=
# Optional private local service store path. Keep it when disabling enrollment; deploy.mjs maps it to cloud StateDirectory.
KCODER_RELAY_REGISTRATION_STORE_FILE=
# Optional private client identity path. If blank, the client helper uses its private default path.
KCODER_RELAY_IDENTITY_FILE=

# Optional private multi-Gateway registry; store this JSON outside the repository.
# It must use sharedHosts ["hyf2333.top:8451"] and gateways with distinct 32+ character
# secret and pairingToken values plus maxConnections, maxBytesPerWindow, trafficWindowMs.
KCODER_RELAY_REGISTRY_FILE=

# Isolated v1 configuration for this workspace; never changes global settings.
KCODER_RELAY_CONFIG_DIR=
