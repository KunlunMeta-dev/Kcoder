# Copy this file to the repository root as .env for workspace tools.
# The CLI also installs this template as ~/.config/kcoder/.env on first launch.
# Fill in credentials in the appropriate private file and keep them out of version control.

# --- Model provider overrides ---
# The API key can be left blank to use configured credentials.
KUNLUNMETA_BASE_API_KEY=
# Provider endpoints and models come from settings.json unless explicitly overridden.
# KUNLUNMETA_BASE_URL=
# KUNLUNMETA_BASE_MODEL=

# --- Studio development and release ---
# dev configure initializes target/studio/.env.launch from the root .env or this template.
# After initialization the fixed Dev instance reads its private launch file.
# Model request and response debug logs may include prompts and output.
DEV_DEBUG=1
# Optional direct Gateway port and Vite bundled development mode.
# KCODER_STUDIO_PORT=4173
# KCODER_STUDIO_VITE_BUNDLED_DEV=1
# Fixed worktree port overrides.
# KCODER_WORKSPACE_DEBUG_PORT=4283
# KCODER_WORKSPACE_EXPO_PORT=14275
# KCODER_WORKSPACE_MOBILE_PORT=4285
# KCODER_WORKSPACE_RELEASE_PORT=4383
# SSH preview port belongs in the private Dev launch file.
# KCODER_WORKSPACE_MOBILE_REMOTE_PORT=
# Release profile and session workspace overrides under the deployment account.
# KCODER_WORKSPACE_RELEASE_HOME=.config/kcoder-workspace-release
# KCODER_WORKSPACE_RELEASE_WORKSPACE=/absolute/path/to/projects

# --- Relay deployment and administration ---
# The deployment machine uses these SSH settings to manage the Relay host.
KCODER_RELAY_SSH_HOSTNAME=relay.example.com
KCODER_RELAY_SSH_USER=deploy
KCODER_RELAY_SSH_IDENTITY=~/.ssh/id_ed25519
# Public HTTPS root for account login, deployment, and connection links.
KCODER_RELAY_PUBLIC_URL=https://relay.example.com
# Relay control and proxy listeners behind Caddy.
KCODER_RELAY_CONTROL_PORT=18452
KCODER_RELAY_PROXY_PORT=18451
# Shared hosts must match the public URL. Registry mode uses path routing.
KCODER_RELAY_SHARED_HOSTS=relay.example.com
KCODER_RELAY_ROUTE_MODE=path
# UDP STUN port, separate from the Relay listeners.
KCODER_RELAY_STUN_PORT=8452
# The Relay server authenticates administrators using the configured password hash.
KCODER_RELAY_ADMIN_USERNAME=admin
# Generate the hash with node apps/kcoder-relay/src/admin-auth.mjs.
# KCODER_RELAY_ADMIN_PASSWORD_HASH=scrypt$<salt-hex>$<hash-hex>
# The administrator panel enables account-based Gateway enrollment by default.
# KCODER_RELAY_REQUIRE_ACCOUNT=1
# Local Relay account and Gateway database override. Cloud deployment uses
# /var/lib/kcoder-relay/registered-gateways.json.
# KCODER_RELAY_REGISTRATION_STORE_FILE=
# Optional private static Relay registry.
# KCODER_RELAY_REGISTRY_FILE=

# --- Standalone Gateway and Mobile Web ---
# The standalone Relay client connects to this local Gateway address.
KCODER_RELAY_LOCAL_GATEWAY=http://127.0.0.1:4186
# KCODER_RELAY_GATEWAY_HOST=127.0.0.1
# Gateway-allowed public origins. The assigned Relay origin is included automatically.
KCODER_RELAY_PUBLIC_ORIGINS=https://relay.example.com
# Optional standalone backend, workspace registry, and profile overrides.
# KCODER_RELAY_KCODER_BIN=
# KCODER_RELAY_SERVERS_FILE=
# KCODER_RELAY_CONFIG_DIR=
# Mobile Web build path and allowed cross-origin browser origins.
# KCODER_STUDIO_MOBILE_WEB_ROOT=/path/to/mobile-web
# KCODER_STUDIO_MOBILE_WEB_ORIGINS=https://relay.example.com
# P2P defaults on. STUN defaults to the Relay hostname and its configured UDP port.
# KCODER_STUDIO_P2P=1
# KCODER_STUDIO_P2P_STUN_URLS=stun:relay.example.com:8452
# Standalone browser login token. The Gateway generates one when omitted.
# KCODER_STUDIO_AUTH_TOKEN=
# Optional fixed mobile pairing token. The pairing tool accepts auto, fixed, or temporary.
KCODER_STUDIO_MOBILE_PAIRING_TOKEN=
KCODER_STUDIO_MOBILE_PAIRING_MODE=auto

# --- Optional standalone enrollment and identity ---
# The Studio account flow stores device credentials in its private instance state.
# Standalone clients can use a one-use login token for enrollment.
# KCODER_RELAY_ACCOUNT_LOGIN_TOKEN=
# An existing identity file stores the Gateway ID and reconnect credential.
# KCODER_RELAY_IDENTITY_FILE=
# The Gateway and Relay use a separate internal signing secret.
# The private secret file takes precedence when configured.
# KCODER_RELAY_GATEWAY_SECRET=
# KCODER_RELAY_GATEWAY_SECRET_FILE=
# Static and legacy modes may require these explicit options.
# Account mode restricts the shared registration key to recovery of existing receipts.
# KCODER_RELAY_GATEWAY_ID=gateway-a
# KCODER_RELAY_REGISTRATION_KEY=

# --- Android release signing and tools ---
# CLI and process settings override repository defaults.
# Keep the keystore and its owner-only password file outside the repository.
# KCODER_ANDROID_KEYSTORE_PATH=/private/kcoder/android-signing/release.p12
# KCODER_ANDROID_KEY_ALIAS=kcoder-release
# The private file contains KCODER_ANDROID_KEYSTORE_PASSWORD and optionally KCODER_ANDROID_KEY_PASSWORD.
# These passwords can also come from the process environment.
# KCODER_ANDROID_SIGNING_ENV_FILE=/private/kcoder/android-signing/signing.env
# ANDROID_HOME=/path/to/android-sdk
# JAVA_HOME=/path/to/jdk
# GRADLE_USER_HOME=/path/to/android-gradle-cache
# Pass --version-code explicitly when building.

# --- Windows release signing ---
# Keep both files outside the repository with owner-only permissions.
# Provide KCODER_WINDOWS_CERTIFICATE_PASSWORD through the private file or process environment.
# Missing signing configuration produces an unsigned installer.
# KCODER_WINDOWS_CERTIFICATE_PATH=/private/kcoder/windows-signing/release.pfx
# KCODER_WINDOWS_SIGNING_ENV_FILE=/private/kcoder/windows-signing/signing.env

# --- Figma reference sync ---
# Run node apps/kcoder-studio/e2e/mobile-design-atlas/figma-sync.mjs.
# Codex manages OAuth. The project registry supplies per-project paths.
KCODER_FIGMA_PROJECT=kcoder-v3
KCODER_FIGMA_PROJECTS_FILE=apps/kcoder-studio/e2e/mobile-design-atlas/figma/projects.json
KCODER_FIGMA_FILE_URL=https://www.figma.com/design/n3ZXIXCF785lwDJMVEj14O/k-coder?node-id=90-2
KCODER_FIGMA_MCP_SERVER=figma
KCODER_FIGMA_CODEX_BIN=codex
# KCODER_FIGMA_CHECKPOINT=docs/phone/figma-sync-checkpoint.json
# KCODER_FIGMA_INDEX=docs/phone/figma-reference.json

# --- Live tests ---
# Private credentials for explicitly requested Relay account and channel tests.
KCODER_RELAY_TEST_USERNAME=
KCODER_RELAY_TEST_PASSWORD=

KCODER_TEST_FEISHU_APP_ID=
KCODER_TEST_FEISHU_APP_SECRET=
KCODER_TEST_QQ_APP_ID=
KCODER_TEST_QQ_APP_SECRET=
KCODER_TEST_WEIXIN_ACCOUNT_ID=
KCODER_TEST_WEIXIN_BOT_TOKEN=
KCODER_TEST_WEIXIN_API_BASE=
