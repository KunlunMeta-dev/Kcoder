+// KCoder 2026-09-24: use explicit UTF-8/UTF-16 and dynamically sized paths.
+static std::wstring kcoderFullWindowsPath(const char *utf8) {
+  int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, NULL, 0);
+  if (n <= 0 || n > 32768) return std::wstring();
+  std::vector<wchar_t> input(n);
+  if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, input.data(), n)) return std::wstring();
+  std::replace(input.begin(), input.end(), L'/', L'\\');
+  DWORD required = GetFullPathNameW(input.data(), 0, NULL, NULL);
+  if (!required || required > 32768) return std::wstring();
+  std::vector<wchar_t> output(required);
+  DWORD length = GetFullPathNameW(input.data(), required, output.data(), NULL);
+  if (!length || length >= required) return std::wstring();
+  return std::wstring(output.data(), length);
+}
+static std::wstring kcoderExtendedWindowsPath(const char *utf8) {
+  std::wstring path = kcoderFullWindowsPath(utf8);
+  if (path.empty() || path.compare(0, 4, L"\\\\?\\") == 0) return path;
+  if (path.compare(0, 2, L"\\\\") == 0) path = L"\\\\?\\UNC\\" + path.substr(2);
+  else if (path.size() > 2 && path[1] == L':') path = L"\\\\?\\" + path;
+  else return std::wstring();
+  return path.size() < 32768 ? path : std::wstring();
+}
