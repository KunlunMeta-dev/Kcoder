[Unit]
Description=KCoder public reverse relay
After=network-online.target
Wants=network-online.target

[Service]
User=kcoder-relay
Group=kcoder-relay
WorkingDirectory=/opt/kcoder-relay
EnvironmentFile=/etc/kcoder-relay.env
StateDirectory=kcoder-relay
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/node /opt/kcoder-relay/src/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=4096
MemoryMax=256M

[Install]
WantedBy=multi-user.target
