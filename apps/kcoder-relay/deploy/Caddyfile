{
    servers {
        protocols h1 h2
    }
}

https://{$KCODER_RELAY_DOMAIN}:{$KCODER_RELAY_PUBLIC_PORT} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }

    handle /_relay/* {
        reverse_proxy 127.0.0.1:{$KCODER_RELAY_CONTROL_PORT} {
            header_up Host {http.request.hostport}
        }
    }

    handle /g/* {
        reverse_proxy 127.0.0.1:{$KCODER_RELAY_PROXY_PORT} {
            # Preserve the public authority for Gateway Host/Origin validation.
            header_up Host {http.request.hostport}
            flush_interval -1
        }
    }

    handle {
        reverse_proxy 127.0.0.1:{$KCODER_RELAY_PROXY_PORT} {
            # Legacy root URLs share the existing endpoint during migration.
            header_up Host {http.request.hostport}
            flush_interval -1
        }
    }
}
