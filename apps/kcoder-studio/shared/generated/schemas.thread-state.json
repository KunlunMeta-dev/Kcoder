  "ThreadPresenceReadResultV1": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "ThreadPresenceReadAbsentReasonV1": {
        "description": "Stable reason for an authoritative State-bound deletion observation.",
        "enum": [
          "boundDeletedPrimarySource"
        ],
        "type": "string"
      },
      "ThreadPresenceReadPresentReasonV1": {
        "description": "Stable reason for a resident runtime being authorized in the current workspace.",
        "enum": [
          "residentRuntime"
        ],
        "type": "string"
      },
      "ThreadPresenceReadUnknownReasonV1": {
        "description": "Stable reasons for an inconclusive observation. Values never include paths or diagnostics.",
        "enum": [
          "coldSourceNotAuthorized",
          "missingHistoryParent",
          "missingControlDirectory",
          "missingControlRecord",
          "missingSourceForLiveRecord",
          "legacyDeletionWithoutBinding",
          "boundDeletionMissingSourceWithoutLock",
          "boundDeletionResidualSameIdentity",
          "compatibilityRootPresent",
          "residentIdentityMismatch",
          "primarySourceUnavailable",
          "busy",
          "unsupported",
          "observationFailed"
        ],
        "type": "string"
      }
    },
    "description": "A disposable, point-in-time presence observation. It is not a deletion receipt.",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "$ref": "#/definitions/ThreadPresenceReadPresentReasonV1"
          },
          "status": {
            "enum": [
              "present"
            ],
            "type": "string"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "reason",
          "status",
          "threadId"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "$ref": "#/definitions/ThreadPresenceReadAbsentReasonV1"
          },
          "status": {
            "enum": [
              "absent"
            ],
            "type": "string"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "reason",
          "status",
          "threadId"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "$ref": "#/definitions/ThreadPresenceReadUnknownReasonV1"
          },
          "status": {
            "enum": [
              "unknown"
            ],
            "type": "string"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "reason",
          "status",
          "threadId"
        ],
        "type": "object"
      }
    ],
    "title": "ThreadPresenceReadResultV1"
  },
