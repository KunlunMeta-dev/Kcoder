  "ThreadMaintenanceParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ThreadMaintenanceOperation": {
        "enum": [
          "compact",
          "rollback"
        ],
        "type": "string"
      },
      "ThreadMaintenanceStatus": {
        "oneOf": [
          {
            "enum": [
              "started",
              "completed",
              "failed"
            ],
            "type": "string"
          },
          {
            "description": "Cancelled before its commit; nothing of this operation was written.",
            "enum": [
              "cancelled"
            ],
            "type": "string"
          }
        ]
      }
    },
    "description": "Payload of `thread/maintenance`. The terminal status is sent after the request's own response, so the response remains the authoritative result.",
    "properties": {
      "maintenanceId": {
        "description": "Opaque identity of this compaction, projected only for opted-in clients.",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
        "type": [
          "string",
          "null"
        ]
      },
      "operation": {
        "$ref": "#/definitions/ThreadMaintenanceOperation"
      },
      "status": {
        "$ref": "#/definitions/ThreadMaintenanceStatus"
      },
      "threadId": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      }
    },
    "required": [
      "operation",
      "status",
      "threadId"
    ],
    "title": "ThreadMaintenanceParams",
    "type": "object"
  },
