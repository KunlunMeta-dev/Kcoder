  "ClientPresentationV1": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "StudioWorkMode": {
        "enum": [
          "kcoder",
          "kworker"
        ],
        "type": "string"
      }
    },
    "description": "Validated by the host for every foreground turn and tool-directory request.",
    "properties": {
      "inlineWidgets": {
        "default": false,
        "type": "boolean"
      },
      "isolatedWidgets": {
        "description": "Current native host has verified isolated script rendering; never restored from history.",
        "type": "boolean"
      },
      "studioWorkMode": {
        "anyOf": [
          {
            "$ref": "#/definitions/StudioWorkMode"
          },
          {
            "type": "null"
          }
        ]
      },
      "version": {
        "format": "uint8",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "version"
    ],
    "title": "ClientPresentationV1",
    "type": "object"
  },
