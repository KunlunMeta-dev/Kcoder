  },
  "ThreadStreamContextV1": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ThreadStreamActiveTurnV1": {
        "anyOf": [
          {
            "$ref": "#/definitions/ThreadStreamTurnV1"
          },
          {
            "type": "null"
          }
        ]
      },
      "ThreadStreamTurnV1": {
        "additionalProperties": false,
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/definitions/TurnStatus"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "attemptId",
          "id",
          "status",
          "threadId"
        ],
        "type": "object"
      },
      "TurnStatus": {
        "enum": [
          "running",
          "completed",
          "interrupted",
          "failed"
        ],
        "type": "string"
      }
    },
    "description": "Negotiated live stream boundary; absence means unknown, not idle.",
    "properties": {
      "activeTurn": {
        "allOf": [
          {
            "$ref": "#/definitions/ThreadStreamActiveTurnV1"
          }
        ],
        "description": "Explicit null confirms that no main turn is active at this boundary."
      },
      "serverId": {
        "type": "string"
      },
      "throughSequence": {
        "description": "Inclusive notification sequence watermark sampled with the live turn identity.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "activeTurn",
      "serverId",
      "throughSequence"
    ],
    "title": "ThreadStreamContextV1",
    "type": "object"
  },
