{
  "McpAppOperationReadParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "connectionId": {
        "type": "string"
      },
      "operationId": {
        "type": "string"
      },
      "revision": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "threadId": {
        "type": "string"
      },
      "widgetId": {
        "type": "string"
      }
    },
    "required": [
      "connectionId",
      "operationId",
      "revision",
      "threadId",
      "widgetId"
    ],
    "title": "McpAppOperationReadParams",
    "type": "object"
  },
  "McpAppOperationStatus": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "enum": [
      "prepared",
      "executing",
      "completed",
      "denied",
      "not_sent",
      "outcome_unknown"
    ],
    "title": "McpAppOperationStatus",
    "type": "string"
  },
  "McpAppReadParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "connectionId": {
        "type": "string"
      },
