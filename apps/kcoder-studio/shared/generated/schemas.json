  "ComputerUseTurnStatusResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ComputerUseAuthorizationState": {
        "enum": [
          "valid",
          "revoked",
          "unknown"
        ],
        "type": "string"
      },
      "ComputerUseChannelState": {
        "enum": [
          "available",
          "unavailable",
          "unknown"
        ],
        "type": "string"
      },
      "ComputerUseCleanupState": {
        "enum": [
          "pending",
          "confirmed",
          "failed",
          "unknown"
        ],
        "type": "string"
      },
      "ComputerUseDiagnostic": {
        "additionalProperties": false,
        "description": "Sanitized operation metadata. Never contains screenshots or window text.",
        "properties": {
          "authorization": {
            "$ref": "#/definitions/ComputerUseAuthorizationState"
          },
          "channel": {
            "$ref": "#/definitions/ComputerUseChannelState"
          },
          "cleanup": {
            "$ref": "#/definitions/ComputerUseCleanupState"
          },
          "elapsedMs": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "hostPid": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "operationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "workerPid": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "authorization",
          "channel",
          "cleanup"
        ],
        "type": "object"
      },
      "ComputerUseStateChanged": {
        "additionalProperties": false,
        "description": "Host lifecycle notification, scoped by the standard server/thread/turn envelope. Contains no bootstrap secret, lease credential or desktop content.",
        "properties": {
          "diagnostic": {
            "anyOf": [
              {
                "$ref": "#/definitions/ComputerUseDiagnostic"
              },
              {
                "type": "null"
              }
            ]
          },
          "recoveryAvailable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "state": {
            "$ref": "#/definitions/DesktopSessionState"
          },
          "target": {
            "$ref": "#/definitions/ComputerUseTarget"
          }
        },
        "required": [
          "state",
          "target"
        ],
        "type": "object"
      },
      "ComputerUseTarget": {
        "enum": [
          "local_windows_desktop"
        ],
        "type": "string"
      },
      "DesktopSessionState": {
        "description": "Observable client lifecycle. Stopped requires a confirmed worker cleanup; StopFailed must never be rendered as successful release of control.",
        "enum": [
          "active",
          "stopping",
          "stopped",
          "stop_failed"
        ],
        "type": "string"
      }
    },
    "description": "A point-in-time read of the exact turn's desktop host observation. `observation: None` means the host state cannot currently be observed; it is not evidence that desktop cleanup completed or that the turn used no desktop.",
    "properties": {
      "observation": {
        "anyOf": [
          {
            "$ref": "#/definitions/ComputerUseStateChanged"
          },
          {
            "type": "null"
          }
        ]
      },
      "sequence": {
        "description": "Watermark in the same outbound sequence as computerUse/stateChanged.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "threadId": {
        "type": "string"
      },
      "turnId": {
        "type": "string"
      }
    },
    "required": [
      "sequence",
      "threadId",
      "turnId"
    ],
    "title": "ComputerUseTurnStatusResult",
    "type": "object"
  },
  "ExecutionDefaultsReadResult": {
