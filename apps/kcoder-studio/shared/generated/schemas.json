        "description": "Opaque app-server lifetime that prevents a transport id from being reused after restart.",
        "type": [
          "string",
          "null"
        ]
      },
      "approvalId": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "serverId": {
        "type": "string"
      },
      "threadId": {
        "type": "string"
      },
      "toolCallId": {
        "description": "Present only when approvalToolCallIdentityV1 was negotiated.",
        "type": [
          "string",
          "null"
        ]
      },
      "turnId": {
        "type": "string"
      }
    },
    "required": [
      "action",
      "approvalId",
      "reason",
      "serverId",
      "threadId",
      "turnId"
