  "ProviderDiscoverModelsParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ProviderAuthentication": {
        "description": "Explicit per-deployment transport authentication, independent of stored keys.",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "api_key"
                ],
                "type": "string"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "none"
                ],
                "type": "string"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          }
        ]
      }
    },
    "description": "Discover an unsaved deployment without requiring a model or persisting credentials.",
    "properties": {
      "apiFormat": {
        "type": "string"
      },
      "apiKey": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "authentication": {
        "allOf": [
          {
            "$ref": "#/definitions/ProviderAuthentication"
          }
        ],
        "default": {
          "mode": "api_key"
        }
      },
      "endpoint": {
        "type": "string"
      },
      "id": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "apiFormat",
      "endpoint"
    ],
    "title": "ProviderDiscoverModelsParams",
    "type": "object"
  },
  "ProviderDiscoveredModels": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
