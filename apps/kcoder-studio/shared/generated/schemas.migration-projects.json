    "type": "object"
  },
  "MigrationProjectReceivedMetadata": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "MigrationProjectLabelOrigin": {
        "enum": [
          "registry_name",
          "path_basename",
          "original_id"
        ],
        "type": "string"
      }
    },
    "description": "A manifest-bound label for a received project, never a target filesystem grant.",
    "properties": {
      "displayName": {
        "type": "string"
      },
      "formatRevision": {
        "type": "string"
      },
      "labelOrigin": {
        "$ref": "#/definitions/MigrationProjectLabelOrigin"
      },
      "originalProjectId": {
        "type": [
          "string",
          "null"
        ]
      },
      "roots": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "displayName",
      "formatRevision",
      "labelOrigin",
      "roots"
    ],
    "title": "MigrationProjectReceivedMetadata",
    "type": "object"
  },
  "MigrationProjectReportParams": {
