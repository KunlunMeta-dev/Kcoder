    "type": "object"
  },
  "MigrationProjectSourcesResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "MigrationProjectDiscoveryProblem": {
        "enum": [
          "registry_unavailable",
          "registry_unsupported",
          "registry_busy",
          "registry_budget_exceeded",
          "registry_changed"
        ],
        "type": "string"
      },
      "MigrationProjectLabelOrigin": {
        "enum": [
          "registry_name",
          "path_basename",
          "original_id"
        ],
        "type": "string"
      },
      "MigrationProjectSourceSummary": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string"
          },
          "labelOrigin": {
            "$ref": "#/definitions/MigrationProjectLabelOrigin"
          },
          "originalProjectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "format": "int64",
            "type": "integer"
          },
          "roots": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "sourceCreatedAtMs": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sourceHandle": {
            "type": "string"
          },
          "sourceUpdatedAtMs": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "displayName",
          "labelOrigin",
          "position",
          "roots",
          "sourceHandle"
        ],
        "type": "object"
      },
      "MigrationProjectUnobserved": {
        "enum": [
          "vendor_metadata",
          "source_trust",
          "worktree_contents",
          "session_recency",
          "legacy_desktop_registry"
        ],
        "type": "string"
      },
      "MigrationSourceKind": {
        "enum": [
          "claude-code",
          "codex"
        ],
        "type": "string"
      }
    },
    "properties": {
      "catalogId": {
        "type": "string"
      },
      "formatRevision": {
        "type": [
          "string",
          "null"
        ]
      },
      "items": {
        "items": {
          "$ref": "#/definitions/MigrationProjectSourceSummary"
        },
        "maxItems": 10,
        "type": "array"
      },
      "knownRowsComplete": {
        "description": "Completeness concerns rows in this declared registry layout, not every vendor feature/version.",
        "type": "boolean"
      },
      "nextPage": {
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "pageIndex": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "problems": {
        "items": {
          "$ref": "#/definitions/MigrationProjectDiscoveryProblem"
        },
        "type": "array"
      },
      "source": {
        "$ref": "#/definitions/MigrationSourceKind"
      },
      "totalItems": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "unobserved": {
        "items": {
          "$ref": "#/definitions/MigrationProjectUnobserved"
        },
        "type": "array"
      }
    },
    "required": [
      "catalogId",
      "items",
      "knownRowsComplete",
      "pageIndex",
      "problems",
      "source",
      "totalItems",
      "unobserved"
    ],
    "title": "MigrationProjectSourcesResult",
    "type": "object"
  },
