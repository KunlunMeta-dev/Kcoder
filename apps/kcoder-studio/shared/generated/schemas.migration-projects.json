    "type": "object"
  },
  "MigrationProjectSourceRootsResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "MigrationProjectSourceRoot": {
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "originalPath": {
            "description": "Preserved foreign path text. Neither source nor target directories are opened from this value.",
            "type": "string"
          },
          "sourceRootId": {
            "type": "string"
          }
        },
        "required": [
          "ordinal",
          "originalPath",
          "sourceRootId"
        ],
        "type": "object"
      }
    },
    "properties": {
      "catalogId": {
        "type": "string"
      },
      "nextPage": {
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "pageIndex": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "roots": {
        "items": {
          "$ref": "#/definitions/MigrationProjectSourceRoot"
        },
        "maxItems": 10,
        "type": "array"
      },
      "sourceHandle": {
        "type": "string"
      },
      "totalRoots": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "catalogId",
      "pageIndex",
      "roots",
      "sourceHandle",
      "totalRoots"
