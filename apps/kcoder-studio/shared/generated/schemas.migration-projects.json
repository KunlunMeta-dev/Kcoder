  "MigrationProjectReportResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "MigrationProjectReportField": {
        "enum": [
          "source_format",
          "original_project_id",
          "source_name",
          "source_root",
          "source_order",
          "source_created_at",
          "source_updated_at",
          "target_workspace",
          "target_root",
          "mapping_status"
        ],
        "type": "string"
      },
      "MigrationProjectReportRow": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "$ref": "#/definitions/MigrationProjectReportField"
          },
          "ordinal": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sourceRootId": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "field"
        ],
        "type": "object"
      },
      "MigrationProjectUnobserved": {
        "enum": [
          "vendor_metadata",
          "source_trust",
          "worktree_contents",
          "session_recency",
          "legacy_desktop_registry"
        ],
        "type": "string"
      }
    },
    "properties": {
      "fields": {
        "items": {
          "$ref": "#/definitions/MigrationProjectReportRow"
        },
        "maxItems": 10,
