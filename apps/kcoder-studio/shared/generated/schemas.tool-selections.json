{
  "SelectableStudioTool": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "StudioWorkMode": {
        "enum": [
          "kcoder",
          "kworker"
        ],
        "type": "string"
      },
      "ToolUiGroup": {
        "enum": [
          "other",
          "files",
          "search",
          "terminal",
          "agents",
          "web",
          "planning"
        ],
        "type": "string"
      },
      "ToolUiIcon": {
        "enum": [
          "tool",
          "file",
          "search",
          "terminal",
          "agent",
          "globe",
          "checklist"
        ],
        "type": "string"
      },
      "ToolUiMetadata": {
        "properties": {
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "displayText": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "group": {
            "$ref": "#/definitions/ToolUiGroup"
          },
          "icon": {
            "$ref": "#/definitions/ToolUiIcon"
          }
        },
        "required": [
          "description",
          "displayName",
          "group",
          "icon"
        ],
        "type": "object"
      }
    },
    "properties": {
      "available": {
        "type": "boolean"
      },
      "name": {
        "type": "string"
      },
      "supportedModes": {
        "items": {
          "$ref": "#/definitions/StudioWorkMode"
        },
        "type": "array"
      },
      "ui": {
        "$ref": "#/definitions/ToolUiMetadata"
      },
      "unavailableReason": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "available",
      "name",
      "supportedModes",
      "ui"
    ],
    "title": "SelectableStudioTool",
    "type": "object"
  },
  "StudioModeToolSelection": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "StudioWorkMode": {
        "enum": [
          "kcoder",
          "kworker"
        ],
        "type": "string"
      }
    },
    "properties": {
      "allowedTools": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "editable": {
        "type": "boolean"
      },
      "mode": {
        "$ref": "#/definitions/StudioWorkMode"
      }
    },
    "required": [
      "allowedTools",
      "editable",
      "mode"
    ],
    "title": "StudioModeToolSelection",
    "type": "object"
  },
  "ToolSelectionsReadParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "OfficeArtifactKind": {
        "enum": [
          "document",
          "table",
          "chart",
          "action_items",
          "research",
          "operation_receipt",
          "file_collection",
          "form"
        ],
        "type": "string"
      },
      "OfficeAssistantDefinition": {
        "additionalProperties": false,
        "properties": {
          "acceptanceCriteria": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowedTools": {
            "description": "None inherits only the already permitted registry; an empty list permits no tools.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "capabilities": {
            "default": [],
            "items": {
              "$ref": "#/definitions/OfficeCapabilityRequirement"
            },
            "type": "array"
          },
          "description": {
            "type": "string"
          },
          "externalSend": {
            "$ref": "#/definitions/OfficeExternalSend"
          },
          "id": {
            "type": "string"
          },
          "inputSchema": true,
          "instructions": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "modelSelection": {
            "$ref": "#/definitions/OfficeModelSelection"
          },
          "outputKinds": {
            "items": {
              "$ref": "#/definitions/OfficeArtifactKind"
            },
            "type": "array"
          },
          "resources": {
            "default": [],
            "items": {
              "$ref": "#/definitions/OfficeResourceRef"
            },
            "type": "array"
          },
          "schemaVersion": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "scope": {
            "$ref": "#/definitions/OfficeAssistantScope"
          },
          "skills": {
            "description": "Reviewed, versioned skill instructions; these never grant tools or execute files.",
            "items": {
              "$ref": "#/definitions/OfficeAssistantSkill"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "workflowRef": {
            "anyOf": [
              {
                "$ref": "#/definitions/OfficeWorkflowRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "acceptanceCriteria",
          "description",
          "externalSend",
          "id",
          "inputSchema",
          "instructions",
          "language",
          "modelSelection",
          "outputKinds",
          "schemaVersion",
          "scope",
          "title"
        ],
        "type": "object"
      },
      "OfficeAssistantScope": {
        "enum": [
          "personal",
          "workspace",
          "organization"
        ],
        "type": "string"
      },
      "OfficeAssistantSkill": {
        "additionalProperties": false,
        "properties": {
          "allowedTools": {
            "description": "Omitted inherits task tools; an explicit list only narrows the registry.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "content",
          "description",
          "enabled",
          "slug",
          "title"
        ],
        "type": "object"
      },
      "OfficeCapabilityRequirement": {
        "additionalProperties": false,
        "properties": {
          "capabilityId": {
            "type": "string"
          },
          "formats": {
            "default": [],
            "items": {
              "$ref": "#/definitions/OfficeFileFormat"
            },
            "type": "array"
          },
          "optional": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "capabilityId"
        ],
        "type": "object"
      },
      "OfficeExternalSend": {
        "enum": [
          "ask",
          "deny"
        ],
        "type": "string"
      },
      "OfficeFileFormat": {
        "enum": [
          "docx",
          "xlsx",
          "pptx",
          "pdf",
          "csv",
          "json"
        ],
        "type": "string"
      },
      "OfficeModelSelection": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "inherit_current"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "explicit"
                ],
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "model",
              "provider"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "auto_policy"
                ],
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "version"
            ],
            "type": "object"
          }
        ]
      },
      "OfficeResourceRef": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "revision"
        ],
        "type": "object"
      },
      "OfficeWorkflowRef": {
        "additionalProperties": false,
        "properties": {
          "definitionId": {
            "type": "string"
          },
          "version": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "definitionId",
          "version"
        ],
        "type": "object"
      }
    },
    "properties": {
      "includeExpertToolSelection": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "includeLunaBaseline": {
        "description": "Request the Luna projection only after observing lunaToolSelectionsV1.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "includeResolution": {
        "description": "Pure next-session preview; never loads resources or changes a task.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "previewExpert": {
        "anyOf": [
          {
            "$ref": "#/definitions/OfficeAssistantDefinition"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "title": "ToolSelectionsReadParams",
    "type": "object"
  },
  "ToolSelectionsResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ResolvedStudioTool": {
        "additionalProperties": false,
        "properties": {
          "effective": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "restrictions": {
            "items": {
              "$ref": "#/definitions/ToolSelectionRestriction"
            },
            "type": "array"
          }
        },
        "required": [
          "effective",
          "name",
          "restrictions"
        ],
        "type": "object"
      },
      "SelectableStudioTool": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "supportedModes": {
            "items": {
              "$ref": "#/definitions/StudioWorkMode"
            },
            "type": "array"
          },
          "ui": {
            "$ref": "#/definitions/ToolUiMetadata"
          },
          "unavailableReason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "available",
          "name",
          "supportedModes",
          "ui"
        ],
        "type": "object"
      },
      "StudioModeToolSelection": {
        "additionalProperties": false,
        "properties": {
          "allowedTools": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "editable": {
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/definitions/StudioWorkMode"
          }
        },
        "required": [
          "allowedTools",
          "editable",
          "mode"
        ],
        "type": "object"
      },
      "StudioToolResolution": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "$ref": "#/definitions/StudioWorkMode"
          },
          "tools": {
            "items": {
              "$ref": "#/definitions/ResolvedStudioTool"
            },
            "type": "array"
          }
        },
        "required": [
          "mode",
          "tools"
        ],
        "type": "object"
      },
      "StudioWorkMode": {
        "enum": [
          "kcoder",
          "kworker"
        ],
        "type": "string"
      },
      "ToolSelectionRestriction": {
        "additionalProperties": false,
        "properties": {
          "skill": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/definitions/ToolSelectionRestrictionSource"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "ToolSelectionRestrictionSource": {
        "enum": [
          "mode_selection",
          "luna_baseline",
          "expert_selection",
          "skill_selection",
          "model_tools_disabled",
          "disabled_by_configuration",
          "inactive_edit_surface",
          "unsupported_mode"
        ],
        "type": "string"
      },
      "ToolUiGroup": {
        "enum": [
          "other",
          "files",
          "search",
          "terminal",
          "agents",
          "web",
          "planning"
        ],
        "type": "string"
      },
      "ToolUiIcon": {
        "enum": [
          "tool",
          "file",
          "search",
          "terminal",
          "agent",
          "globe",
          "checklist"
        ],
        "type": "string"
      },
      "ToolUiMetadata": {
        "properties": {
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "displayText": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "group": {
            "$ref": "#/definitions/ToolUiGroup"
          },
          "icon": {
            "$ref": "#/definitions/ToolUiIcon"
          }
        },
        "required": [
          "description",
          "displayName",
          "group",
          "icon"
        ],
        "type": "object"
      }
    },
    "properties": {
      "expertToolsIndependent": {
        "description": "The selected expert replaces the ordinary task's user tool selection.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "lunaAllowedTools": {
        "description": "Expert baseline from target settings, independent of Studio mode defaults. Omission means an older target cannot report it; an empty list disables all tools.",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "modes": {
        "items": {
          "$ref": "#/definitions/StudioModeToolSelection"
        },
        "type": "array"
      },
      "resolution": {
        "description": "Available only on an explicitly requested preview. It is not execution authorization.",
        "items": {
          "$ref": "#/definitions/StudioToolResolution"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "revision": {
        "type": "string"
      },
      "tools": {
        "items": {
          "$ref": "#/definitions/SelectableStudioTool"
        },
        "type": "array"
      },
      "total": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "modes",
      "revision",
      "tools",
      "total",
      "truncated"
    ],
    "title": "ToolSelectionsResult",
    "type": "object"
  },
  "ToolSelectionsSaveParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "StudioWorkMode": {
        "enum": [
          "kcoder",
          "kworker"
        ],
        "type": "string"
      }
    },
    "properties": {
      "allowedTools": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "expectedRevision": {
        "type": "string"
      },
      "mode": {
        "$ref": "#/definitions/StudioWorkMode"
      }
    },
    "required": [
      "allowedTools",
      "expectedRevision",
      "mode"
    ],
    "title": "ToolSelectionsSaveParams",
    "type": "object"
  }
}
