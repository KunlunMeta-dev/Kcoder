    "type": "object"
  },
  "WikiFindingsListResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "WikiFindingDecisionKind": {
        "oneOf": [
          {
            "description": "A person reviewed the range and confirms it is acceptable.",
            "enum": [
              "confirmed"
            ],
            "type": "string"
          },
          {
            "description": "A person dismissed the finding (for example after editing elsewhere).",
            "enum": [
              "dismissed"
            ],
            "type": "string"
          }
        ]
      },
      "WikiUnverifiedVerdict": {
        "description": "Why a published line range is not counted as verified.",
        "oneOf": [
          {
            "description": "The independent verification judged the range unsupported by its evidence.",
            "enum": [
              "unsupported"
            ],
            "type": "string"
          },
          {
            "description": "The independent verification could not decide.",
            "enum": [
              "uncertain"
            ],
            "type": "string"
          },
          {
            "description": "No usable verification verdict exists (budget, size or format limits).",
            "enum": [
              "unassessed"
            ],
            "type": "string"
          }
        ]
      },
      "WikiVerificationFinding": {
        "additionalProperties": false,
        "description": "A durable verification finding bound to one immutable page revision.",
        "properties": {
          "bodyHash": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "createdAtMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "current": {
            "description": "True while the finding's revision is still the page's current revision.",
            "type": "boolean"
          },
          "decidedAtMs": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/definitions/WikiFindingDecisionKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "findingId": {
            "type": "string"
          },
          "firstLine": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "jobId": {
            "type": "string"
          },
          "lastLine": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "pageId": {
            "type": "string"
          },
          "revisionId": {
            "type": "string"
          },
          "verdict": {
            "$ref": "#/definitions/WikiUnverifiedVerdict"
          }
        },
        "required": [
          "bodyHash",
          "code",
          "createdAtMs",
          "current",
          "findingId",
          "firstLine",
          "jobId",
          "lastLine",
          "pageId",
          "revisionId",
          "verdict"
        ],
        "type": "object"
      }
    },
    "properties": {
      "items": {
        "items": {
          "$ref": "#/definitions/WikiVerificationFinding"
        },
        "type": "array"
      },
      "nextAfterId": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "items"
    ],
    "title": "WikiFindingsListResult",
    "type": "object"
  },
