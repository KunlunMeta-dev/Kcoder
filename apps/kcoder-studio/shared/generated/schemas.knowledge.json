          "lastLine",
          "verdict"
        ],
        "type": "object"
      },
      "WikiPageVerificationStatus": {
        "oneOf": [
          {
            "description": "Every assessed range of this revision was verified.",
            "enum": [
              "verified"
            ],
            "type": "string"
          },
          {
            "description": "Some ranges are unsupported/uncertain/unassessed and not yet confirmed.",
            "enum": [
              "partial"
            ],
            "type": "string"
          },
          {
            "description": "The revision was produced by the file contract but has no assessment.",
            "enum": [
              "unassessed"
            ],
            "type": "string"
          },
          {
            "description": "Revision predates verification findings (or was imported).",
            "enum": [
              "legacy"
            ],
            "type": "string"
          },
          {
            "description": "A person edited this revision; generated findings do not apply to it.",
            "enum": [
              "human_edited"
            ],
            "type": "string"
          }
        ]
      },
      "WikiUnverifiedVerdict": {
        "description": "Why a published line range is not counted as verified.",
        "oneOf": [
          {
            "description": "The independent verification judged the range unsupported by its evidence.",
            "enum": [
              "unsupported"
            ],
            "type": "string"
          },
          {
            "description": "The independent verification could not decide.",
            "enum": [
              "uncertain"
            ],
            "type": "string"
          },
          {
            "description": "No usable verification verdict exists (budget, size or format limits).",
            "enum": [
              "unassessed"
            ],
            "type": "string"
          }
        ]
      }
    },
    "description": "Page-read projection of the revision's open findings.",
    "properties": {
      "status": {
        "$ref": "#/definitions/WikiPageVerificationStatus"
      },
      "unverified": {
        "default": [],
        "items": {
          "$ref": "#/definitions/WikiPageUnverifiedLines"
        },
        "type": "array"
      }
    },
    "required": [
      "status"
    ],
    "title": "WikiPageVerification",
    "type": "object"
  },
