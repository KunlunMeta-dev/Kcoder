  "WikiFindingsListParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "afterId": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "includeDecided": {
        "default": false,
        "description": "Include confirmed/dismissed findings and findings of older revisions.",
        "type": "boolean"
      },
