      },
      "findingId": {
        "type": "string"
      },
      "firstLine": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "jobId": {
        "type": "string"
      },
      "lastLine": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "pageId": {
        "type": "string"
      },
      "revisionId": {
        "type": "string"
      },
      "verdict": {
        "$ref": "#/definitions/WikiUnverifiedVerdict"
