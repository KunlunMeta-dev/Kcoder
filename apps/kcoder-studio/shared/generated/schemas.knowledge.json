  "WikiPageVerification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "WikiPageUnverifiedLines": {
        "additionalProperties": false,
        "properties": {
          "firstLine": {
            "format": "uint",
            "minimum": 0,
