  },
  "WikiJobProgress": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "ModelConfigurationBoundary": {
        "enum": [
          "next_turn",
          "session_snapshot"
        ],
        "type": "string"
      },
      "ModelConfigurationSummary": {
        "additionalProperties": false,
        "description": "Public effective model metadata. Deliberately excludes URLs, credentials, arbitrary extra-body keys/values and filesystem paths.",
        "properties": {
          "apiFormat": {
            "type": [
              "string",
              "null"
            ]
          },
          "boundary": {
            "allOf": [
              {
                "$ref": "#/definitions/ModelConfigurationBoundary"
              }
            ],
            "description": "Whether this describes newly resolved settings or a pinned running snapshot."
          },
          "chatProtocol": {
            "type": "string"
          },
          "contextWindowTokens": {
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "extraBodyConfigured": {
            "type": "boolean"
          },
          "maxOutputTokens": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "modelId": {
            "type": "string"
          },
          "outputHeadroomTokens": {
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "providerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": "boolean"
          },
          "reasoningEffort": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoningPolicy": {
            "anyOf": [
              {
                "$ref": "#/definitions/ModelReasoningPolicy"
              },
              {
                "type": "null"
              }
            ]
          },
          "requestOutputLimits": {
            "additionalProperties": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": "object"
          },
          "requestOverrideFields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "revision": {
            "description": "Opaque revision of the private semantics; never an encoding of their value.",
            "type": "string"
          },
          "sources": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Predefined field names and authority labels only.",
            "type": "object"
          },
          "structuredOutput": {
            "type": "boolean"
          },
          "text": {
            "type": "boolean"
          },
          "toolSet": {
            "anyOf": [
              {
                "$ref": "#/definitions/ModelToolSetSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Actual host composition; missing in older records, never inferred from capability."
          },
          "tools": {
            "type": "boolean"
          },
          "vision": {
            "type": "boolean"
          }
        },
        "required": [
          "boundary",
          "chatProtocol",
          "extraBodyConfigured",
          "modelId",
          "reasoning",
          "requestOutputLimits",
          "requestOverrideFields",
          "revision",
          "sources",
          "structuredOutput",
          "text",
          "tools",
          "vision"
        ],
        "type": "object"
      },
      "ModelReasoningPolicy": {
        "additionalProperties": false,
        "description": "User-declared controls, not a claim that an upstream model was verified.",
        "properties": {
          "efforts": {
            "default": [],
            "items": {
              "pattern": "[^\\u{9}\\u{a}\\u{b}\\u{c}\\u{d}\\u{20}\\u{85}\\u{a0}\\u{1680}\\u{2000}\\u{2001}\\u{2002}\\u{2003}\\u{2004}\\u{2005}\\u{2006}\\u{2007}\\u{2008}\\u{2009}\\u{200a}\\u{2028}\\u{2029}\\u{202f}\\u{205f}\\u{3000}]",
              "type": "string"
            },
            "type": "array"
          },
          "mode": {
            "$ref": "#/definitions/ReasoningControlMode"
          }
        },
        "required": [
          "mode"
        ],
        "type": "object"
      },
      "ModelToolRegistryScope": {
        "enum": [
          "profile_configuration",
          "session_registry",
          "session_role",
          "wiki_worker"
        ],
        "type": "string"
      },
      "ModelToolSetSummary": {
        "additionalProperties": false,
        "description": "The count describes registered tools at this scope, before request permissions.",
        "properties": {
          "exposedToolCount": {
            "description": "Only populated when the actual provider request definitions are captured.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "registeredToolCount": {
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "registryScope": {
            "$ref": "#/definitions/ModelToolRegistryScope"
          }
        },
        "required": [
          "registryScope"
        ],
        "type": "object"
      },
      "ReasoningControlMode": {
        "enum": [
          "hidden",
          "optional",
          "always_on",
          "always_off"
        ],
        "type": "string"
      }
    },
    "description": "Safe facts authored by the host. No source text, model response or credentials.",
    "properties": {
      "callLimit": {
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "estimatedInputTokens": {
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "firstPage": {
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "heartbeatAtMs": {
        "format": "int64",
        "type": "integer"
      },
      "inputTokens": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "lastPage": {
        "format": "uint32",
