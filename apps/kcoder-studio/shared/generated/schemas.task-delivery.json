        "properties": {
          "deviceId": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "deviceId",
          "taskId",
          "threadId"
        ],
        "type": "object"
      }
    },
    "properties": {
      "baseBranch": {
        "type": "string"
      },
      "comparisonId": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "owner": {
