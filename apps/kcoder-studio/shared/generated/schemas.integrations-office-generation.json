            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tables": {
            "description": "DOCX only, up to 20 text tables, each row matching its headers.",
            "items": {
              "$ref": "#/definitions/OfficeTextTableSpec"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "template": {
            "description": "Fixed layout only: DOCX report/letter; PPTX briefing/minimal. No imported template path.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "User-language title, at most 200 characters.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "schemaVersion",
          "title"
        ],
        "type": "object"
      },
