              "$ref": "#/definitions/OfficeParagraphSpec"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "schemaVersion": {
            "description": "Must be 1. Only structured new documents are supported.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "sheets": {
            "description": "XLSX only, 1..16 uniquely named sheets. Numbers must be finite and JS-safe for integer writes.",
