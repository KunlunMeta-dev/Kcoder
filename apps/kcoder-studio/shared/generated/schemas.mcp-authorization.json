  "McpProviderRevocationPhase": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "enum": [
      "prepared",
      "accepted",
      "unknown",
      "unsupported",
      "rejected"
    ],
    "title": "McpProviderRevocationPhase",
    "type": "string"
  },
  "McpProviderRevocationReason": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "enum": [
      "awaitingConfirmation",
      "providerAccepted",
      "outcomeUnconfirmed",
      "endpointNotAdvertised",
      "authenticationUnsupported",
      "tokenTypeUnsupported",
      "authorizationUnavailable",
      "sourceChanged",
      "credentialsChanged",
      "providerRejected",
      "intentExpired",
      "preparationCancelled",
      "originalReceiptUnavailable"
    ],
    "title": "McpProviderRevocationReason",
    "type": "string"
  },
  "McpProviderRevocationReceipt": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "IntegrationRevisionRef": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
