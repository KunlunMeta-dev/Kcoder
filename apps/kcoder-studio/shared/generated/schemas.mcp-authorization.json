            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    "description": "A native prepared reference is required before an explicit provider request. Callers cannot supply an endpoint, token, client secret or account override.",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "prepare"
            ],
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "server": {
            "$ref": "#/definitions/McpServerParams"
          }
        },
        "required": [
          "action",
          "requestId",
          "server"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "commit"
            ],
            "type": "string"
          },
          "intentRef": {
            "$ref": "#/definitions/IntegrationRevisionRef"
          },
          "requestId": {
            "type": "string"
          },
          "server": {
            "$ref": "#/definitions/McpServerParams"
          }
        },
        "required": [
          "action",
          "intentRef",
          "requestId",
          "server"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "cancel"
            ],
            "type": "string"
          },
          "intentRef": {
            "$ref": "#/definitions/IntegrationRevisionRef"
          },
          "requestId": {
            "type": "string"
          },
          "server": {
            "$ref": "#/definitions/McpServerParams"
          }
        },
        "required": [
          "action",
          "intentRef",
          "requestId",
          "server"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "read"
            ],
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "server": {
            "$ref": "#/definitions/McpServerParams"
          }
        },
        "required": [
          "action",
          "requestId",
          "server"
        ],
        "type": "object"
      }
    ],
    "title": "McpProviderRevocationParams"
