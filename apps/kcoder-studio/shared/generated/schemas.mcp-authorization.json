      },
      "requestId": {
        "type": "string"
      },
      "sourceState": {
        "$ref": "#/definitions/McpProviderRevocationSourceState"
      }
    },
    "required": [
      "currentSourceMatches",
      "localCredentialsRemoved",
      "phase",
      "reason",
      "requestId",
      "sourceState"
    ],
