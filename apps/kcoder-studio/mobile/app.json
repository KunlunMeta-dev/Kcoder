{
  "expo": {
    "name": "KCoder Studio",
    "slug": "kcoder-studio",
    "scheme": "kcoder-studio",
    "version": "2.0.9",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.kcoder.studio"
    },
    "android": {
      "package": "dev.kcoder.studio",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0b0b0c"
      },
      "versionCode": 31
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "\u5141\u8bb8 KCoder Studio \u4f7f\u7528\u76f8\u673a\u626b\u63cf Gateway \u914d\u5bf9\u4e8c\u7ef4\u7801\u6216\u62cd\u6444\u4efb\u52a1\u9644\u4ef6",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "\u5141\u8bb8 KCoder Studio \u4ece\u7167\u7247\u56fe\u5e93\u9009\u62e9\u4efb\u52a1\u9644\u4ef6",
          "cameraPermission": "\u5141\u8bb8 KCoder Studio \u62cd\u6444\u4efb\u52a1\u9644\u4ef6",
          "microphonePermission": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "\u5141\u8bb8 KCoder Studio \u4f7f\u7528\u76f8\u673a\u626b\u63cf Gateway \u914d\u5bf9\u4e8c\u7ef4\u7801\u6216\u62cd\u6444\u4efb\u52a1\u9644\u4ef6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
