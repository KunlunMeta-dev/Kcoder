{
  "name": "@kcoder/studio-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "npm run build:terminal-webview",
    "start": "expo start",
    "preweb": "npm run build:terminal-webview",
    "web": "expo start --web --port 4175",
    "preandroid": "npm run build:terminal-webview",
    "android": "expo run:android",
    "preios": "npm run build:terminal-webview",
    "ios": "expo run:ios",
    "prebuild:web": "npm run build:terminal-webview",
    "build:web": "expo export --platform web",
    "pack:web": "npm run build:web && node -e \"require('node:fs').mkdirSync('../../../target/packages/kcoder-studio-mobile',{recursive:true})\" && npm pack --pack-destination ../../../target/packages/kcoder-studio-mobile",
    "build:terminal-webview": "node scripts/build-terminal-webview.mjs",
    "pretypecheck": "npm run build:terminal-webview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "base64-js": "^1.5.1",
    "expo": "^54.0.18",
    "expo-build-properties": "^1.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.17",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "^17.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "^0.546.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
