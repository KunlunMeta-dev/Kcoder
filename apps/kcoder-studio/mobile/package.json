{
  "name": "@kcoder/studio-mobile",
  "version": "2.0.9",
  "private": true,
  "main": "src/entry.ts",
  "scripts": {
    "prestart": "npm run build:terminal-webview",
    "start": "expo start",
    "preweb": "npm run build:terminal-webview",
    "web": "expo start --web --port 4175",
    "preandroid": "npm run build:terminal-webview",
    "android": "expo run:android",
    "preios": "npm run build:terminal-webview",
    "ios": "expo run:ios",
    "prebuild:web": "npm run build:terminal-webview",
    "build:web": "node scripts/export-gateway-web.mjs",
    "pack:web": "npm run build:web && node -e \"require('node:fs').mkdirSync('../../../target/packages/kcoder-studio-mobile',{recursive:true})\" && npm pack --pack-destination ../../../target/packages/kcoder-studio-mobile",
    "build:terminal-webview": "node scripts/build-terminal-webview.mjs",
    "pretypecheck": "npm run build:terminal-webview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../../scripts/release/artifact-manifest.mjs --npm . mobile-web"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "base64-js": "^1.5.1",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.4.2",
    "lucide-react-native": "^0.546.0",
    "punycode": "2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "esbuild": "^0.28.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.6"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "kcoder-release-manifest.json"
  ]
}
